---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection";
import MarqueeSection from "../components/MarqueeSection";
import AboutPreview from "../components/AboutPreview";
import FeaturedProjects from "../components/FeaturedProjects";
import TechStackSection from "../components/TechStackSection";
import CTASection from "../components/CTASection";
---

<Layout
	title="Akash | Cloud Engineer & DevOps Specialist"
	description="Akash is an Associate Software Engineer specializing in Cloud Infrastructure, DevOps, CI/CD, and Full-Stack Development. Explore my projects and contact me for freelance work."
>
	<HeroSection client:load />
	
	<section class="section-space about-space">
		<div class="section-content">
			<MarqueeSection client:visible />
			<AboutPreview client:visible />
		</div>
	</section>
	
	<section class="section-space projects-space">
		<div class="section-content">
			<FeaturedProjects client:visible />
		</div>
	</section>
	
	<section class="section-space skills-space">
		<div class="section-content">
			<TechStackSection client:visible />
		</div>
	</section>
	
	<section class="section-space contact-space">
		<div class="section-content">
			<CTASection client:visible />
		</div>
	</section>
</Layout>
